# Copier ce fichier en .env puis adapter. Aucune clé n'est obligatoire.
# Une variable laissée vide est ignorée (valeur par défaut). Sur Vercel, ne déclarez que ce dont vous avez besoin.

# --- LLM (optionnel) : auto | none | anthropic | gemini | openai | ollama
# auto = anthropic si ANTHROPIC_API_KEY, sinon gemini si GEMINI_API_KEY, sinon openai si OPENAI_API_KEY,
# sinon mode extractif sans LLM.
LLM_PROVIDER=auto
LLM_MODEL=
ANTHROPIC_API_KEY=
# Gemini (Google AI Studio, offre gratuite) : https://aistudio.google.com -> "Get API key"
# Modèle par défaut : gemini-flash-lite-latest, puis secours automatique sur d'autres modèles si le quota du jour est épuisé
GEMINI_API_KEY=
OPENAI_API_KEY=
# Pour un serveur compatible OpenAI (Groq, Mistral, OpenRouter, LM Studio...) ou Ollama :
LLM_BASE_URL=

# --- Traduction des citations quand la langue de l'utilisateur diffère de celle de la source
# auto = LLM si configuré, sinon MyMemory (gratuit, sans clé, ~5 000 caractères/jour ; les phrases citées
# sont envoyées à api.mymemory.translated.net) | llm | mymemory | none
TRANSLATION_PROVIDER=auto
# Facultatif : e-mail pour passer à ~50 000 caractères/jour chez MyMemory
MYMEMORY_EMAIL=

# --- Stockage (sur Vercel : toujours sous /tmp, ces valeurs sont ignorées)
# CHROMA_DIR=data/chroma
# UPLOAD_DIR=data/uploads
COLLECTION_NAME=unipods_memory

# --- Embeddings : default (ONNX local, gratuit) | sentence-transformers | openai
# Changer de backend impose de réindexer (--reset).
EMBEDDING_BACKEND=default
EMBEDDING_MODEL=

# --- Découpage et recherche
CHUNK_MIN_WORDS=300
CHUNK_MAX_WORDS=500
TOP_K=4
MIN_RELEVANCE=0.30

# --- Bot Telegram (optionnel)
TELEGRAM_BOT_TOKEN=
API_URL=http://localhost:8000
